{
  "info": {
    "name": "Hospital Management API",
    "description": "Organized by feature. Start with Authentication > Initial Admin Setup once on a fresh database. Then create users and log in with the relevant role. Appointment requests include patient and doctor self views, admin scoped views, booking, and owner-only deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Public authentication endpoints. Initial Admin Setup is for a fresh database and succeeds only once.",
      "item": [
        {
          "name": "Initial Admin Setup (run once)",
          "description": "Creates the first ADMIN while there are no users. Set adminName, adminEmail, and adminPassword in the environment first. The role is assigned by the server.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('First admin is created', function () {",
            "    pm.response.to.have.status(201);",
            "    const body = pm.response.json();",
            "    pm.expect(body.role).to.eql('ADMIN');",
            "    pm.environment.set('adminId', body.id);",
            "});"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/bootstrap-admin"
          }
        },
        {
          "name": "Admin Login",
          "description": "Logs in and saves the JWT as adminToken for the Admin folder requests.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin login returns token and ADMIN role', function () {",
            "    pm.response.to.have.status(200);",
            "    const body = pm.response.json();",
            "    pm.expect(body.token).to.be.a('string').and.not.empty;",
            "    pm.expect(body.role).to.eql('ADMIN');",
            "    pm.environment.set('adminToken', body.token);",
            "    pm.environment.set('adminId', body.userId);",
            "});"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Patient Login",
          "description": "Logs in as the patient created by Admin > User Management and saves userToken/userId.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Patient login returns token and PATIENT role', function () {",
            "    pm.response.to.have.status(200);",
            "    const body = pm.response.json();",
            "    pm.expect(body.role).to.eql('PATIENT');",
            "    pm.environment.set('userToken', body.token);",
            "    pm.environment.set('userId', body.userId);",
            "    pm.environment.set('patientId', body.userId);",
            "});"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Nurse Login",
          "description": "Logs in as a nurse and saves nurseToken. Set nurseEmail and nursePassword in the environment first.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Nurse login returns token and NURSE role', function () {",
            "    pm.response.to.have.status(200);",
            "    const body = pm.response.json();",
            "    pm.expect(body.role).to.eql('NURSE');",
            "    pm.environment.set('nurseToken', body.token);",
            "    pm.environment.set('nurseId', body.userId);",
            "});"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{nurseEmail}}\",\n  \"password\": \"{{nursePassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Doctor Login",
          "description": "Logs in as a doctor and saves doctorToken. Set doctorEmail and doctorPassword in the environment first.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Doctor login returns token and DOCTOR role', function () {",
            "    pm.response.to.have.status(200);",
            "    const body = pm.response.json();",
            "    pm.expect(body.role).to.eql('DOCTOR');",
            "    pm.environment.set('doctorToken', body.token);",
            "    pm.environment.set('doctorId', body.userId);",
            "});"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Admin-only features. Set adminToken by running Authentication > Admin Login.",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        {
          "name": "User Management",
          "description": "Create users with the role they need. Change newUserRole as required (ADMIN, DOCTOR, PATIENT, NURSE, MEDICAL_STAFF).",
          "item": [
            {
              "name": "Create User",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "if (!pm.environment.get('newUserEmail')) pm.environment.set('newUserEmail', 'postman.patient.' + Date.now() + '@example.com');",
                  "if (!pm.environment.get('newUserPassword')) pm.environment.set('newUserPassword', 'PostmanPatientPass123!');",
                  "if (!pm.environment.get('newUserName')) pm.environment.set('newUserName', 'Postman Test Patient');",
                  "if (!pm.environment.get('newUserRole')) pm.environment.set('newUserRole', 'PATIENT');"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "pm.test('User created with requested role', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql(pm.environment.get('newUserRole') || 'PATIENT');",
                  "    pm.expect(body.enabled).to.eql(true);",
                  "    pm.environment.set('userId', body.id);",
                  "    if (body.role === 'PATIENT') pm.environment.set('patientId', body.id);",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{newUserName}}\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"role\": \"{{newUserRole}}\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/admin/users"
              }
            }
          ]
        },
        {
          "name": "Authorization Checks",
          "description": "Role-denial checks. Run Admin Login and Patient Login first.",
          "item": [
            {
              "name": "Reject User Creation Without Token",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Unauthenticated user creation returns 401', function () { pm.response.to.have.status(401); });"
              ] } }],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Unauthorized Attempt\",\n  \"email\": \"unauthorized@example.com\",\n  \"password\": \"NotARealPass123!\",\n  \"role\": \"PATIENT\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/admin/users"
              }
            },
            {
              "name": "Reject User Creation With Patient Token",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Non-admin user creation returns 403', function () { pm.response.to.have.status(403); });"
              ] } }],
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Not Be Created\",\n  \"email\": \"forbidden@example.com\",\n  \"password\": \"NotARealPass123!\",\n  \"role\": \"PATIENT\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/admin/users"
              }
            },
            {
              "name": "Reject Patient Profile Read With Admin Token",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Admin role cannot access patient-only profile routes', function () { pm.response.to.have.status(403); });"
              ] } }],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/profile/{{userId}}"
              }
            },
            {
              "name": "Deny Unconfigured API Route By Default",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Authenticated request to an unconfigured API route returns 403', function () { pm.response.to.have.status(403); });"
              ] } }],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/rbac-policy-check"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Appointments",
      "description": "Patients can book for themselves. Admins and nurses can book for a patient by ID. Patients, doctors, and nurses can view their own or assigned appointments. Admins can view all appointments and filter by patient or doctor. Only the appointment's patient or doctor can delete it.",
      "item": [
        {
          "name": "Patient",
          "description": "Run Authentication > Patient Login first.",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
          "item": [
            {
              "name": "Book Appointment For Myself",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "const appointmentAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "appointmentAt.setHours(10, 0, 0, 0);",
                  "pm.environment.set('appointmentAt', appointmentAt.toISOString().slice(0, 19));"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "pm.test('Patient appointment is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(String(body.patientId)).to.eql(String(pm.environment.get('userId')));",
                  "    pm.environment.set('appointmentId', body.id);",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"appointmentAt\": \"{{appointmentAt}}\",\n  \"reason\": \"Postman test appointment\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/appointments"
              }
            },
            {
              "name": "Get My Appointments",
              "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/appointments/mine" }
            },
            {
              "name": "Delete My Appointment",
              "description": "Deletes an appointment only if the signed-in patient is its patient. Uses appointmentId saved by the booking request or set manually.",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Patient deletes own appointment', function () { pm.response.to.have.status(204); });"
              ] } }],
              "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/appointments/{{appointmentId}}" }
            }
          ]
        },
        {
          "name": "Nurse",
          "description": "Run Authentication > Nurse Login first. Set patientId and doctorId from Admin > User Management or prior login results.",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{nurseToken}}", "type": "string" }] },
          "item": [
            {
              "name": "Book Appointment For Patient",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "const appointmentAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "appointmentAt.setHours(11, 0, 0, 0);",
                  "pm.environment.set('appointmentAt', appointmentAt.toISOString().slice(0, 19));"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "pm.test('Nurse appointment is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('appointmentId', body.id);",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"patientId\": {{userId}},\n  \"doctorId\": {{doctorId}},\n  \"nurseId\": {{nurseId}},\n  \"appointmentAt\": \"{{appointmentAt}}\",\n  \"reason\": \"Nurse booked appointment\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/appointments"
              }
            },
            { "name": "Get Appointments Assigned To Me", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/appointments/mine" } },
            {
              "name": "Delete Assigned Appointment (Expected 403)",
              "description": "Nurses cannot delete appointments. Use a real appointmentId to verify the role restriction.",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Nurse cannot delete appointments', function () { pm.response.to.have.status(403); });"
              ] } }],
              "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/appointments/{{appointmentId}}" }
            }
          ]
        },
        {
          "name": "Doctor",
          "description": "Run Authentication > Doctor Login first.",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
          "item": [
            { "name": "Get Appointments Assigned To Me", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/appointments/mine" } },
            {
              "name": "Delete Assigned Appointment",
              "description": "Deletes an appointment only if it is assigned to the signed-in doctor. Uses appointmentId saved by booking or set manually.",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Doctor deletes assigned appointment', function () { pm.response.to.have.status(204); });"
              ] } }],
              "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/appointments/{{appointmentId}}" }
            }
          ]
        },
        {
          "name": "Admin",
          "description": "Run Authentication > Admin Login first.",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
          "item": [
            {
              "name": "Book Appointment For Patient",
              "event": [
                { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
                  "const appointmentAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "appointmentAt.setHours(12, 0, 0, 0);",
                  "pm.environment.set('appointmentAt', appointmentAt.toISOString().slice(0, 19));"
                ] } },
                { "listen": "test", "script": { "type": "text/javascript", "exec": [
                  "pm.test('Admin appointment is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.environment.set('appointmentId', body.id);",
                  "});"
                ] } }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"patientId\": {{userId}},\n  \"doctorId\": {{doctorId}},\n  \"nurseId\": {{nurseId}},\n  \"appointmentAt\": \"{{appointmentAt}}\",\n  \"reason\": \"Admin booked appointment\"\n}", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/appointments"
              }
            },
            { "name": "Get All Appointments", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/admin/appointments" } },
            { "name": "Get Appointments For Patient", "description": "Set patientId to the selected patient's user ID (Authentication > Patient Login or Admin > Create User populates it when creating a patient).", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/admin/appointments/patient/{{patientId}}" } },
            { "name": "Get Appointments For Doctor", "description": "Uses doctorId populated by Authentication > Doctor Login.", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/admin/appointments/doctor/{{doctorId}}" } }
          ]
        }
      ]
    },
    {
      "name": "Patient Profile",
      "description": "Patient profile operations. Run Patient Login first to populate userToken and userId.",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create Own Profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Profile creation returns 201', function () {",
            "    pm.response.to.have.status(201);",
            "    const body = pm.response.json();",
            "    pm.expect(body.id).to.exist;",
            "    pm.environment.set('profileId', body.id);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateOfBirth\": \"1990-01-01\",\n  \"phoneNumber\": \"000-000-0000\",\n  \"address\": \"Postman Test Address\",\n  \"emergencyContactName\": \"Test Contact\",\n  \"emergencyContactPhone\": \"000-000-0001\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/profile"
          }
        },
        {
          "name": "Get Own Profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Own profile fetch returns 200', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(String(pm.response.json().id)).to.eql(String(pm.environment.get('profileId')));",
            "});"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/profile/{{userId}}" }
        },
        {
          "name": "Update Own Profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Own profile update returns updated data', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().phoneNumber).to.eql('000-000-0002');",
            "});"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dateOfBirth\": \"1990-01-01\",\n  \"phoneNumber\": \"000-000-0002\",\n  \"address\": \"Updated Postman Test Address\",\n  \"emergencyContactName\": \"Updated Test Contact\",\n  \"emergencyContactPhone\": \"000-000-0003\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/profile/{{userId}}"
          }
        },
        {
          "name": "Reject Unauthenticated Profile Read",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Unauthenticated profile fetch returns 401', function () { pm.response.to.have.status(401); });"
          ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/profile/{{userId}}" }
        },
        {
          "name": "Reject Reading Another User Profile",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.environment.set('otherUserId', String(Number(pm.environment.get('userId')) + 999999));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Reading another account profile returns 403', function () { pm.response.to.have.status(403); });"
            ] } }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/profile/{{otherUserId}}" }
        }
      ]
    }
  ]
}
