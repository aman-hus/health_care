{
  "info": {
    "name": "Hospital Management API",
    "description": "Multi-hospital API. Fresh database: run Initial Platform Admin Setup, log in as platform admin without a hospitalId, create a hospital, then log in as the hospital admin created during hospital provisioning. Hospital admins create users under their token hospital.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "User Directory",
      "description": "Lists users in the selected hospital only. Set userDirectoryToken to a valid bearer token for that hospital. Password hashes are never returned.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{userDirectoryToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User directory returns users for the selected hospital', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const users = pm.response.json();",
                  "    pm.expect(users).to.be.an('array');",
                  "    users.forEach(function (user) {",
                  "        pm.expect(user).to.have.all.keys('id', 'name', 'email', 'role', 'enabled', 'createdAt', 'updatedAt');",
                  "        pm.expect(user).not.to.have.property('passwordHash');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get User By ID",
          "description": "Uses userId from the environment. Run a role login or create a user first to populate it.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User lookup returns the requested user without credentials', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const user = pm.response.json();",
                  "    pm.expect(String(user.id)).to.eql(String(pm.environment.get('userId')));",
                  "    pm.expect(user).to.have.all.keys('id', 'name', 'email', 'role', 'enabled', 'createdAt', 'updatedAt');",
                  "    pm.expect(user).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Reject All Users Without Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated user directory request returns 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "On a fresh database, create a platform admin account without creating a hospital. Log in as the platform admin, then create hospitals separately in the Admin folder. Hospital-scoped user creation uses the hospital admin token hospital.",
      "item": [
        {
          "name": "List Hospitals (select before login)",
          "description": "Returns active hospital IDs, names, and codes. The test selects hospitalId if already set; otherwise it selects the first hospital. Change hospitalId in the environment to work with another hospital.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Active hospital list is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const hospitals = pm.response.json();",
                  "    pm.expect(hospitals).to.be.an('array');",
                  "    if (hospitals.length) {",
                  "        let selected = hospitals.find(h => String(h.id) === String(pm.environment.get('hospitalId')));",
                  "        if (!selected) selected = hospitals[0];",
                  "        pm.environment.set('hospitalId', selected.id);",
                  "        pm.environment.set('hospitalCode', selected.code);",
                  "        pm.environment.set('hospitalName', selected.name);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/hospitals"
          }
        },
        {
          "name": "Initial Platform Admin Setup (run once)",
          "description": "Fresh database only. Creates only the first PLATFORM_ADMIN account. Set adminName, adminEmail, and adminPassword. Then log in as the platform admin and create a hospital separately using Admin > Hospital Management > Create Hospital.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('First admin is created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('PLATFORM_ADMIN');",
                  "    pm.environment.set('adminId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/bootstrap-admin"
          }
        },
        {
          "name": "Admin Login",
          "description": "Logs in and saves the JWT as adminToken for the Admin folder requests.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Platform admin login returns a token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(['ADMIN', 'PLATFORM_ADMIN']).to.include(body.role);",
                  "    pm.environment.set('adminToken', body.token);",
                  "    pm.environment.set('adminId', body.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Patient Login",
          "description": "Logs in as the patient created by Admin > User Management and saves userToken/userId.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Patient login returns token and PATIENT role', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('PATIENT');",
                  "    pm.expect(String(body.hospitalId)).to.eql(String(pm.environment.get('hospitalId')));",
                  "    pm.environment.set('userToken', body.token);",
                  "    pm.environment.set('userDirectoryToken', body.token);",
                  "    pm.environment.set('userId', body.userId);",
                  "    pm.environment.set('patientId', body.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"hospitalId\": {{hospitalId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Nurse Login",
          "description": "Logs in as a nurse and saves nurseToken. Set nurseEmail and nursePassword in the environment first.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Nurse login returns token and NURSE role', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('NURSE');",
                  "    pm.environment.set('nurseToken', body.token);",
                  "    pm.environment.set('userDirectoryToken', body.token);",
                  "    pm.environment.set('nurseId', body.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{nurseEmail}}\",\n  \"password\": \"{{nursePassword}}\",\n  \"hospitalId\": {{hospitalId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Doctor Login",
          "description": "Logs in as a doctor and saves doctorToken. Set doctorEmail and doctorPassword in the environment first.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Doctor login returns token and DOCTOR role', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('DOCTOR');",
                  "    pm.environment.set('doctorToken', body.token);",
                  "    pm.environment.set('userDirectoryToken', body.token);",
                  "    pm.environment.set('doctorId', body.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\",\n  \"hospitalId\": {{hospitalId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Medical Staff Login",
          "description": "Logs in as medical staff and saves medicalStaffToken and the generic userDirectoryToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Medical staff login returns token and MEDICAL_STAFF role', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('MEDICAL_STAFF');",
                  "    pm.environment.set('medicalStaffToken', body.token);",
                  "    pm.environment.set('medicalStaffId', body.userId);",
                  "    pm.environment.set('userDirectoryToken', body.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{medicalStaffEmail}}\",\n  \"password\": \"{{medicalStaffPassword}}\",\n  \"hospitalId\": {{hospitalId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Hospital Admin Login",
          "description": "Logs in as the hospital admin created by Create Hospital (Platform Admin). Uses newHospitalId and saves adminToken for that hospital.",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test('Hospital admin login returns ADMIN role for the created hospital', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql('ADMIN');",
                  "    pm.expect(String(body.hospitalId)).to.eql(String(pm.environment.get('newHospitalId')));",
                  "    pm.environment.set('adminToken', body.token);",
                  "    pm.environment.set('userDirectoryToken', body.token);",
                  "    pm.environment.set('adminId', body.userId);",
                  "    pm.environment.set('hospitalId', body.hospitalId);",
                  "});"
                ],
                "type": "text/javascript"
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{hospitalAdminEmail}}\",\n  \"password\": \"{{hospitalAdminPassword}}\",\n  \"hospitalId\": {{newHospitalId}}\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "method": "POST",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Platform admins use adminToken to create hospitals. After provisioning, run Hospital Admin Login before hospital-scoped user and appointment requests.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Hospital Management",
          "description": "Platform admins create hospitals separately from their platform account. Hospital-specific operations use a hospital admin token.",
          "item": [
            {
              "name": "Create Hospital (Platform Admin)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Hospital and first hospital admin are created', function () {",
                      "    pm.response.to.have.status(201);",
                      "    const body = pm.response.json();",
                      "    pm.expect(body.hospitalId).to.exist;",
                      "    pm.expect(body.adminId).to.exist;",
                      "    pm.expect(body.adminEmail).to.eql(pm.environment.get('hospitalAdminEmail'));",
                      "    pm.environment.set('newHospitalId', body.hospitalId);",
                      "    pm.environment.set('newHospitalCode', body.code);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{newHospitalName}}\",\n  \"code\": \"{{newHospitalCodeInput}}\",\n  \"adminName\": \"{{hospitalAdminName}}\",\n  \"adminEmail\": \"{{hospitalAdminEmail}}\",\n  \"adminPassword\": \"{{hospitalAdminPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/admin/hospitals"
              },
              "description": "Platform admin only. Creates a hospital and its first ADMIN account in one transaction. The response returns hospitalId and admin details. The platform admin is not added as a hospital member."
            },
            {
              "name": "List Hospitals (Admin)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/admin/hospitals"
              }
            }
          ]
        },
        {
          "name": "User Management",
          "description": "Hospital admins create accounts for their selected hospital. The hospital is taken from the bearer token; do not send hospitalId in this request. Set newUserRole to ADMIN, DOCTOR, PATIENT, NURSE, or MEDICAL_STAFF.",
          "item": [
            {
              "name": "Create User",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (!pm.environment.get('newUserEmail')) pm.environment.set('newUserEmail', 'postman.patient.' + Date.now() + '@example.com');",
                      "if (!pm.environment.get('newUserPassword')) pm.environment.set('newUserPassword', 'PostmanPatientPass123!');",
                      "if (!pm.environment.get('newUserName')) pm.environment.set('newUserName', 'Postman Test Patient');",
                      "if (!pm.environment.get('newUserRole')) pm.environment.set('newUserRole', 'PATIENT');"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('User created with requested role and token hospital', function () {",
                      "    pm.response.to.have.status(201);",
                      "    const body = pm.response.json();",
                      "    pm.expect(body.role).to.eql(pm.environment.get('newUserRole') || 'PATIENT');",
                      "    pm.expect(body.enabled).to.eql(true);",
                      "    pm.expect(String(body.hospitalId)).to.eql(String(pm.environment.get('hospitalId')));",
                      "    pm.environment.set('userId', body.id);",
                      "    if (body.role === 'PATIENT') pm.environment.set('patientId', body.id);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{newUserName}}\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"role\": \"{{newUserRole}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/admin/users"
              },
              "description": "Creates the user in the hospital selected by the bearer token. Do not send hospitalId; the response includes it."
            }
          ]
        },
        {
          "name": "Authorization Checks",
          "description": "Role-denial checks. Run Admin Login and Patient Login first.",
          "item": [
            {
              "name": "Reject User Creation Without Token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Unauthenticated user creation returns 401', function () { pm.response.to.have.status(401); });"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Unauthorized Attempt\",\n  \"email\": \"unauthorized@example.com\",\n  \"password\": \"NotARealPass123!\",\n  \"role\": \"PATIENT\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/admin/users"
              }
            },
            {
              "name": "Reject User Creation With Patient Token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Non-admin user creation returns 403', function () { pm.response.to.have.status(403); });"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{userToken}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Should Not Be Created\",\n  \"email\": \"forbidden@example.com\",\n  \"password\": \"NotARealPass123!\",\n  \"role\": \"PATIENT\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/admin/users"
              }
            },
            {
              "name": "Reject Patient Profile Read With Admin Token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin role cannot access patient-only profile routes', function () { pm.response.to.have.status(403); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/profile/{{userId}}"
              }
            },
            {
              "name": "Deny Unconfigured API Route By Default",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Authenticated request to an unconfigured API route returns 403', function () { pm.response.to.have.status(403); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/rbac-policy-check"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Appointments",
      "description": "Patients book for themselves; admins book for patients. New bookings are PENDING until the assigned doctor accepts (SCHEDULED) or rejects (REJECTED). Patients and assigned doctors can reschedule pending or scheduled appointments. Nurses cannot book appointments.",
      "item": [
        {
          "name": "Patient",
          "description": "Run Authentication > Patient Login first.",
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{userToken}}",
                "type": "string"
              }
            ]
          },
          "item": [
            {
              "name": "Book Appointment For Myself",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const appointmentAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                      "appointmentAt.setHours(10, 0, 0, 0);",
                      "pm.environment.set('appointmentAt', appointmentAt.toISOString().slice(0, 19));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Patient appointment is created', function () {",
                      "    pm.response.to.have.status(201);",
                      "    const body = pm.response.json();",
                      "    pm.expect(String(body.patientId)).to.eql(String(pm.environment.get('userId')));",
                      "    pm.expect(body.status).to.eql('PENDING');",
                      "    pm.environment.set('appointmentId', body.id);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"appointmentAt\": \"{{appointmentAt}}\",\n  \"reason\": \"Postman test appointment\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/api/appointments"
              }
            },
            {
              "name": "Get My Appointments",
              "request": {
